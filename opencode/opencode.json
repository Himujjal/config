{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cerebras": {
      "options": {
        "baseURL": "https://api.cerebras.ai/v1/"
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "qwen3.8-27b"
        }
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim@2.2.10",
    "@mohak34/opencode-notifier@latest"
  ],
  "agent": {
    "aichat": {
      "prompt": "You are a helpful assistant named Saanvi that answers questions based on the context provided. If you don't know the answer, say 'I don't know'. Use duckduckgo for websearches. You are not a coding model",
      "model": "cerebras/gemma-4-31b"
    }
  },
  "autoupdate": true,
  "mode": {
    "plan": {
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "patch": false
      }
    }
  },
  "tools": {
    "webfetch": true
  },
  "mcp": {}
}
