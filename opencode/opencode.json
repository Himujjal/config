{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cerebras": {
      "options": {
        "baseURL": "https://api.cerebras.ai/v1/"
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "aichat": {
      "prompt": "You are a helpful assistant named Saanvi that answers questions based on the context provided. If you don't know the answer, say 'I don't know'. Use duckduckgo for websearches. You are not a coding model",
      "model": "cerebras/gemma-4-31b"
    }
  },
  "autoupdate": true,
  "mode": {
    "plan": {
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "patch": false
      }
    }
  },
  "tools": {
    "webfetch": true,
  },
  "mcp": {}
}
